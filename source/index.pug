extends _templates/layout.pug

block peasisu
    script.
            // On Load of the window
            window.onload = function () {

              var data = JSON.parse('!{ JSON.stringify(self.data) }');

              // Start calendar
              var c = new Calendar2();
              c.data = data;
              c.lang = JSON.parse('!{ JSON.stringify(self.valitud_keel) }');
              c.init();

            }

    ul#kalender.kalender-p2is.t2islai-tabel.keskel
        li.kolmandik-veerg
            h3
                a(href="#")
                    span.prev-month
        li.kolmandik-veerg
            h3.pruun-tekst
                span.current-month-year
        li.kolmandik-veerg
            h3
                a(href="#")
                    span.next-month
    div.kalender-sisu-wrapper
        ul.kalender-sisu.keskel

